# Template environment clau-ai-agents. Pakai: scripts/init-env.sh (salin ke .env + isi password
# database acak), lalu sesuaikan. .env TIDAK di-commit (.gitignore) dan dibuat chmod 600.
# File ini hanya berisi nama variabel dan nilai aman, TIDAK PERNAH secret. Dibaca docker compose
# (interpolasi); tanpa Docker: export variabel ini sebelum menjalankan uvicorn.
# Setiap variabel yang dibaca kode wajib tercantum di sini (dites: backend/tests/test_env.py).

## Backend (backend/app/main.py, docs/security.md § 3)
# production | development. Default aman = production. Untuk kerja lokal ganti ke development
# (membuka /docs dan /openapi.json, dan cookie login tanpa Secure untuk Safari di http://localhost).
# Jangan pakai development di server.
CLAU_ENV=production
# Override /docs: 1 = buka, 0 = tutup. Tidak diisi = ikut CLAU_ENV.
# CLAU_ENABLE_DOCS=0
# Header Host yang diterima, dipisah koma (cegah Host header injection). Compose selalu menambahkan
# "backend" dan "127.0.0.1" (panggilan internal frontend & healthcheck).
CLAU_ALLOWED_HOSTS=localhost

## Login (backend/app/auth, docs/security.md § 6)
# Kunci server untuk token CSRF dan enkripsi secret 2FA. Minimal 32 karakter; kosong = login
# dimatikan (503). Dibuat acak oleh scripts/init-env.sh. Mengganti kunci = semua sesi & 2FA harus
# diatur ulang (reset-mfa), jadi simpan cadangannya di password manager owner.
CLAU_SECRET_KEY=
# Origin browser yang boleh mengirim request ubah data (koma). Kosong = http://127.0.0.1:<port frontend>
# dan http://localhost:<port frontend>. Di server isi https://app.<domain>.
# CLAU_ALLOWED_ORIGINS=https://app.contoh.id
# Sesi berakhir setelah tidak aktif sekian menit, dan paling lama sekian jam sejak login.
CLAU_SESSION_IDLE_MINUTES=120
CLAU_SESSION_MAX_HOURS=12
# Jumlah hash Argon2id (64 MiB per hash) yang boleh berjalan bersamaan; sisanya antre. Default 3.
# CLAU_HASH_CONCURRENCY=3
# Hanya untuk otomasi `python -m app.auth.cli create-owner` (tanpa prompt). Jangan disimpan di .env.
# CLAU_BOOTSTRAP_PASSWORD=

## Frontend (server Next.js). Tanpa CLAU_BACKEND_URL = pratinjau data SIMULASI tanpa login (VPS 1).
# 1 = semua halaman wajib login (docker compose default 1). Kosong/0 = tanpa penjaga halaman.
CLAU_AUTH_ENABLED=1
# Alamat backend dari sisi server Next.js; tidak pernah dari browser. Compose: http://backend:8000.
# CLAU_BACKEND_URL=http://127.0.0.1:8000

## Port host docker compose (selalu 127.0.0.1; publik lewat Nginx + TLS)
CLAU_BACKEND_PORT=8000
CLAU_FRONTEND_PORT=3000

## Deploy VPS 1 (scripts/deploy/vps1-deploy.sh). Default sudah benar; ubah hanya bila layout server beda.
# CLAU_ROOT=/srv/clau
# CLAU_BRANCH=main            # clau-deploy.service memakai release/vps1 (hanya commit main yang CI-nya hijau)
# CLAU_HEALTH_URL=http://127.0.0.1:3000
# CLAU_RESTART=sudo -n /usr/bin/systemctl restart clau-frontend

## Database (PostgreSQL 16 di docker compose; tidak punya port host)
# Tiga password terpisah: admin Postgres (hanya service migrate), role migrasi (pemilik schema),
# role aplikasi (backend; tanpa hak DDL). scripts/init-env.sh mengisinya dengan heksadesimal acak.
# Hanya huruf & angka (dipakai di URL koneksi). Ganti password = ubah di sini lalu
# `docker compose run --rm migrate` (bootstrap menyetel ulang password role).
# POSTGRES_PASSWORD hanya dipakai saat volume db-data pertama kali dibuat; mengubahnya setelah itu
# tidak mengganti password admin di volume lama (hapus volume: `docker compose down -v`, data hilang).
POSTGRES_PASSWORD=
CLAU_DB_MIGRATOR_PASSWORD=
CLAU_DB_APP_PASSWORD=
# URL koneksi dirakit docker compose dari password di atas. Isi manual hanya bila jalan tanpa Docker:
# CLAU_DATABASE_URL=            postgresql+psycopg://clau_app:<pw>@127.0.0.1:5432/clau  (backend)
# CLAU_MIGRATION_DATABASE_URL=  postgresql+psycopg://clau_migrator:<pw>@127.0.0.1:5432/clau  (alembic)
# CLAU_DB_ADMIN_URL=            postgresql://postgres:<pw>@127.0.0.1:5432/postgres  (bootstrap)
# Nama database & role (default sudah benar):
# CLAU_DB_NAME=clau
# CLAU_DB_MIGRATOR_ROLE=clau_migrator
# CLAU_DB_APP_ROLE=clau_app

## Backup database terenkripsi (scripts/db-backup.sh, db-restore.sh). Dibuat acak oleh init-env.sh.
## Tanpa passphrase ini backup tidak bisa dibuka: simpan di password manager owner, terpisah dari backup.
CLAU_BACKUP_PASSPHRASE=

## Test database (pytest backend). Superuser Postgres sekali pakai; setiap sesi test membuat dan
## menghapus database & role sendiri. Tanpa ini test database dilewati (CI mewajibkannya).
# CLAU_TEST_DB_ADMIN_URL=
# CLAU_REQUIRE_DB_TESTS=1

## Planned (VPS 2): BELUM dibaca kode. Jangan diisi sebelum fiturnya dibangun sesuai
## docs/security.md § 6. Secret (API key AI, WhatsApp) hanya di .env server
## (chmod 600, user service khusus), tidak pernah di repo, tidak pernah di log.
